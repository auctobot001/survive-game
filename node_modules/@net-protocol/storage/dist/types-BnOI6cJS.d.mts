    enabled?: boolean;
};

export type { BulkStorageKey as B, ChunkedMetadata as C, StorageClientOptions as S, UseStorageOptions as U, XmlReference as X, StorageData as a, BulkStorageResult as b, UseXmlStorageOptions as c, UseStorageFromRouterOptions as d };
