import { Abi } from 'viem';

type NetMessage = {
    app: `0x${string}`;
    sender: `0x${string}`;
    timestamp: bigint;
    data: `0x${string}`;
    text: string;
    topic: string;
};
type NetMessageFilter = {
    appAddress: `0x${string}`;
    topic?: string;
    maker?: `0x${string}`;
};
type NetClientMessagesOptions = {
    filter?: NetMessageFilter;
    startIndex?: number;
    endIndex?: number;
};
type NetClientMessageCountOptions = {
    filter?: NetMessageFilter;
};
type GetNetMessagesOptions = {
    chainId: number;
    filter?: NetMessageFilter;
    startIndex?: number;
    endIndex?: number;
    rpcUrl?: string | string[];
};
type GetNetMessageCountOptions = {
    chainId: number;
    filter?: NetMessageFilter;
    rpcUrl?: string | string[];
};
type UseNetMessagesOptions = GetNetMessagesOptions & {
    enabled?: boolean;
};
type UseNetMessageCountOptions = GetNetMessageCountOptions & {
    refetchInterval?: number;
    enabled?: boolean;
};
type UseNetMessagesBatchAsyncOptions = UseNetMessagesOptions & {
    batchCount?: number;
};

type WriteTransactionConfig = {
    to: `0x${string}`;
    functionName: string;
    args: unknown[];
    value?: bigint;
    abi: Abi;
};

export type { GetNetMessagesOptions as G, NetClientMessagesOptions as N, UseNetMessagesOptions as U, WriteTransactionConfig as W, NetMessage as a, NetClientMessageCountOptions as b, NetMessageFilter as c, GetNetMessageCountOptions as d, UseNetMessageCountOptions as e, UseNetMessagesBatchAsyncOptions as f };
